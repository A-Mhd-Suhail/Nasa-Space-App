{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "science", "format": "url", "env": "SCIENCE_API_URL" }
      ]
    },
    "science": {
      "root": "science",
      "framework": "fastapi",
      "entrypoint": "moonnav_science/api.py",
      "buildCommand": "python3 scripts/fetch_runtime_data.py",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "MOONNAV_INTERNAL_API_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ],
  "crons": [
    { "path": "/api/internal/cron/drain", "schedule": "0 4 * * *" }
  ]
}
