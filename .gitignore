# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MoonNav local data (downloaded sources, local db, objects, outbox)
/data/raw/
/data/pg/
/data/objects/
/data/outbox/
/data/*.log
/science/.venv/
__pycache__/
/test-results/
/playwright-report/
.env*.local
!.env.example
/data/logs/
/data/qa/
/backups/

# Claude Code per-machine settings
.claude/settings.local.json

# All local data (downloaded NASA products, high-res tile cache, local Postgres, objects, outbox)
/data/
# Tool caches and scratch files
/science/.pytest_cache/
/science/.ruff_cache/
.ruff_cache/
.mypy_cache/
*.tmp.mjs
# Secrets: never commit (keep .env.example only)
*.key
*.p12
service-account*.json

# Vercel science build output (runtime NASA data)
/science/data/
