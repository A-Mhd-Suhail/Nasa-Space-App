{
  "openapi": "3.1.0",
  "info": {
    "title": "MoonNav Science API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "summary": "Products",
        "operationId": "products_v1_products_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Products V1 Products Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terrain/point": {
      "get": {
        "summary": "Terrain Point",
        "operationId": "terrain_point_v1_terrain_point_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lon"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "lola-ldem-75s-240m-v2",
              "title": "Product"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Terrain Point V1 Terrain Point Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/horizon": {
      "post": {
        "summary": "Horizon",
        "operationId": "horizon_v1_horizon_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HorizonRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Horizon V1 Horizon Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terrain/patch": {
      "get": {
        "summary": "Terrain Patch",
        "description": "Height grid in a local ENU tangent frame centred on the site (for 3D display).\n\nHeights are radius - (R_ref + site height) measured along the local up axis,\nso lunar curvature is included in the display mesh. Missing samples are null.",
        "operationId": "terrain_patch_v1_terrain_patch_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": -75,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lon"
            }
          },
          {
            "name": "half_size_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 60000,
              "minimum": 2000,
              "default": 20000,
              "title": "Half Size M"
            }
          },
          {
            "name": "grid",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 401,
              "minimum": 17,
              "default": 161,
              "title": "Grid"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "lola-ldem-75s-240m-v2",
              "title": "Product"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Terrain Patch V1 Terrain Patch Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/terrain/profile": {
      "get": {
        "summary": "Terrain Profile",
        "description": "Terrain heights and elevation angles along one azimuth (great circle), curvature included.",
        "operationId": "terrain_profile_v1_terrain_profile_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": -75,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lon"
            }
          },
          {
            "name": "azimuth",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360,
              "title": "Azimuth"
            }
          },
          {
            "name": "max_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 300000,
              "minimum": 1000,
              "default": 50000,
              "title": "Max M"
            }
          },
          {
            "name": "observer_height_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100,
              "minimum": 0,
              "default": 2.0,
              "title": "Observer Height M"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "lola-ldem-75s-240m-v2",
              "title": "Product"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Terrain Profile V1 Terrain Profile Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_v1_analyze_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Analyze V1 Analyze Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "scenario": {
            "additionalProperties": true,
            "type": "object",
            "title": "Scenario"
          }
        },
        "type": "object",
        "required": [
          "scenario"
        ],
        "title": "AnalyzeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HorizonRequest": {
        "properties": {
          "latitudeDeg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitudedeg"
          },
          "longitudeEastDeg": {
            "type": "number",
            "title": "Longitudeeastdeg"
          },
          "observerHeightM": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Observerheightm",
            "default": 2.0
          },
          "azimuthStepDeg": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.1,
            "title": "Azimuthstepdeg",
            "default": 0.5
          },
          "maxRadiusM": {
            "type": "number",
            "maximum": 450000.0,
            "minimum": 1000.0,
            "title": "Maxradiusm",
            "default": 300000
          },
          "terrainProductId": {
            "type": "string",
            "title": "Terrainproductid",
            "default": "lola-ldem-75s-240m-v2"
          }
        },
        "type": "object",
        "required": [
          "latitudeDeg",
          "longitudeEastDeg"
        ],
        "title": "HorizonRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}