# MoonNav configuration. Names and descriptions only - never commit real values.
# Copy to .env.local for development. Use separate values for local, preview and production.

# --- App ---
APP_URL=http://localhost:3000            # Public base URL (used in emails, share links)

# --- PostgreSQL ---
DATABASE_URL=                            # Supabase: postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL_DIRECT=                     # Direct connection for migrations/admin tasks (optional locally)

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=                      # >= 32 random chars: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000    # Must equal APP_URL

# --- Science service / worker ---
SCIENCE_API_URL=http://127.0.0.1:8001    # Internal base URL of the FastAPI service
SCIENCE_SERVICE_TOKEN=                   # Shared bearer token (>= 24 chars) between web app, API and worker
MOONNAV_INTERNAL_API_URL=http://localhost:3000  # (worker only) web app base URL for the job API

# --- Object storage ---
STORAGE_DRIVER=local                     # local (dev/test) | supabase (production) | r2 (unused alternative)
SUPABASE_STORAGE_BUCKET=moonnav-objects  # private bucket used when STORAGE_DRIVER=supabase (needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, server-side only)
LOCAL_STORAGE_DIR=data/objects           # local driver root (dev/test only)
STORAGE_SIGNING_SECRET=                  # >= 32 chars, signs local short-lived download URLs
# R2_* are only needed for the unused STORAGE_DRIVER=r2 alternative:
R2_ACCOUNT_ID=                           # Cloudflare account id
R2_ENDPOINT=                             # https://<account>.r2.cloudflarestorage.com (optional if account id set)
R2_BUCKET=                               # e.g. moonnav-prod (use a different bucket per environment)
R2_ACCESS_KEY_ID=                        # R2 API token access key (server-side only)
R2_SECRET_ACCESS_KEY=                    # R2 API token secret (server-side only)

# --- Email ---
MAIL_DRIVER=outbox                       # outbox (local only: data/outbox, view at /dev/mail) | smtp | resend
SMTP_HOST=                               # e.g. smtp.gmail.com (MAIL_DRIVER=smtp; Gmail: port 465 + SMTP_SECURE=true + Google App Password)
SMTP_PORT=587                            # 587 STARTTLS or 465 TLS
SMTP_SECURE=false                        # true for port 465
SMTP_USER=                               # SMTP username (e.g. your Gmail address)
SMTP_PASSWORD=                           # SMTP password / app password (server-side only)
RESEND_API_KEY=                          # required when MAIL_DRIVER=resend
MAIL_FROM="MoonNav <no-reply@example.org>"

# --- Data backend (Supabase-ready; NOT connected by default) ---
# postgres (default): repositories use DATABASE_URL directly. This works with local PostgreSQL and
#                     with a Supabase-hosted database (use its connection strings above).
# supabase:           repositories use the Supabase client below. If any Supabase variable is
#                     missing the app logs a warning and falls back to postgres; it never crashes.
DATA_BACKEND=postgres
NEXT_PUBLIC_SUPABASE_URL=                # https://<project-ref>.supabase.co (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # anon key (public; every table is protected by RLS, drizzle/0007)
SUPABASE_SERVICE_ROLE_KEY=               # SERVER ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.

# --- Optional ---
# NEXT_PUBLIC_REPO_URL=                  # shown in the footer when set

# Science service: writable cache for high-res LOLA tiles (default data/tiles; on Vercel use /tmp/moonnav-tiles)
MOONNAV_TILE_CACHE=

# Vercel only: on-demand analysis jobs (no polling worker). JOB_MODE=on-demand enables it locally.
JOB_MODE=
CRON_SECRET=                             # Vercel Cron bearer secret for /api/internal/cron/drain
