{
  "name": "moonnav",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "./scripts/dev-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "science:dev": "./scripts/dev-science.sh",
    "science:test": "cd science && uv run pytest -q",
    "worker:dev": "./scripts/dev-worker.sh",
    "data:fetch": "./scripts/fetch_data.sh",
    "data:assets": "cd science && uv run python scripts/build_assets.py",
    "db:seed-dev": "tsx --env-file=.env.local scripts/seed-dev.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "setup": "./scripts/setup.sh",
    "health": "node scripts/health.mjs",
    "prod:local": "next build && next start -p 3100",
    "science:validate": "cd science && uv run python scripts/validate.py",
    "data:hires": "cd science && uv run python scripts/ingest_hires.py",
    "data:illum": "cd science && uv run python scripts/fetch_illumination.py && uv run python scripts/build_illumination_layers.py",
    "data:relief": "cd science && uv run python scripts/build_global_relief.py",
    "dev:web": "next dev -p 3100",
    "mail:test": "tsx --env-file=.env.local scripts/mail-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "@electric-sql/pglite": "0.5.16",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.19",
    "drizzle-orm": "0.45.4",
    "echarts": "6.1.0",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "nodemailer": "10.2.1",
    "ol": "10.11.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
